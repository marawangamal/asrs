   "source": [
    "import torch\n",
    "\n",
    "B, D, top_k = 16, 32, 4\n",
    "alphas_all = torch.randn(B, D)\n",
    "alphas = - torch.ones_like(alphas_all) * float('inf')\n",
    "topk_vals, topk_ids = torch.topk(alphas_all, top_k, dim=-1)\n",
    "alphas = alphas.scatter_(-1, topk_ids, topk_vals) # ()\n",
    "alphas"
   ]
